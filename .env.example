# Copy to .env (which git ignores), fill in your Alpaca PAPER keys, then load it
# into your shell before running anything that talks to Alpaca:
#     set -a; source .env; set +a
# Paper key IDs start with "PK". Live keys (starting "AK") are refused.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# Access token for the web UI (8+ characters; use a long random one if the site is
# reachable from anywhere but your own devices). Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(32))"
BASELINE_UI_TOKEN=
